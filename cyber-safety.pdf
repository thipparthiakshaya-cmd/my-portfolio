<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cyber Safety Checker</title>

    <link rel="stylesheet" href="https://thipparthiakshaya-cmd.github.io/Cyber-safety-checker-website/style.css">
</head>

<body>

    <div class="container">

        <h1>🔐 Cyber Safety Checker</h1>

        <p>
            Check how safely you use the internet!
        </p>

        <form id="cyberForm">

            <label>1. Do you use strong and unique passwords?</label>
            <select id="password">
                <option value="10">Yes</option>
                <option value="5">Sometimes</option>
                <option value="0">No</option>
            </select>

            <label>2. Do you use Two-Factor Authentication (2FA)?</label>
            <select id="twofa">
                <option value="10">Yes</option>
                <option value="5">On some accounts</option>
                <option value="0">No</option>
            </select>

            <label>3. Do you check links before clicking them?</label>
            <select id="links">
                <option value="10">Always</option>
                <option value="5">Sometimes</option>
                <option value="0">No</option>
            </select>

            <label>4. Do you share your password with others?</label>
            <select id="sharing">
                <option value="0">Never</option>
                <option value="5">Sometimes</option>
                <option value="10">Often</option>
            </select>

            <label>5. Do you keep your apps and software updated?</label>
            <select id="updates">
                <option value="10">Yes</option>
                <option value="5">Sometimes</option>
                <option value="0">No</option>
            </select>

            <label>6. Do you avoid entering personal information on unknown websites?</label>
            <select id="personal">
                <option value="10">Yes</option>
                <option value="5">Sometimes</option>
                <option value="0">No</option>
            </select>

            <button type="submit">
                Check My Safety Score 🛡️
            </button>

        </form>

        <div id="result" class="result"></div>

    </div>

    


</body></html>
