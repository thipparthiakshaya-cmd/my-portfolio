@charset "utf-8";

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { font-family: Arial, sans-serif; background: rgb(227, 242, 253); min-height: 100vh; display: flex; justify-content: center; align-items: center; }

.container { width: 90%; max-width: 650px; background: white; padding: 30px; border-radius: 15px; box-shadow: rgba(0, 0, 0, 0.15) 0px 5px 20px; }

h1 { text-align: center; margin-bottom: 10px; }

p { text-align: center; color: rgb(85, 85, 85); margin-bottom: 25px; }

label { display: block; margin-top: 18px; margin-bottom: 7px; font-weight: bold; }

select { width: 100%; padding: 12px; border: 1px solid rgb(170, 170, 170); border-radius: 8px; font-size: 15px; }

button { width: 100%; margin-top: 25px; padding: 14px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 8px; background: rgb(21, 101, 192); color: white; font-size: 17px; cursor: pointer; }

button:hover { background: rgb(13, 71, 161); }

.result { margin-top: 25px; padding: 20px; border-radius: 10px; text-align: center; font-size: 18px; font-weight: bold; background: rgb(232, 245, 233); }
